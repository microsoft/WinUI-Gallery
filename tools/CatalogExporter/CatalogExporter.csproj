<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>WinUIGallery.CatalogExporter</RootNamespace>
        <AssemblyName>WinUIGallery.CatalogExporter</AssemblyName>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsPackable>false</IsPackable>
        <!-- Turns the source-generated contexts in CatalogJsonContext.cs into a guarantee rather
             than a convention: with reflection disabled, any type reached by the serializer that a
             context does not cover throws at runtime instead of quietly falling back. -->
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <!-- This is a plain, platform-agnostic console/library project (no WinUI/Windows App SDK
             dependency) so it can build and run in any CI environment, independent of the
             Windows-only WinUIGallery app project. -->
    </PropertyGroup>

    <ItemGroup>
        <!-- CodeDeclarations reads the C# beside each snippet to decide whether the snippet hands
             the reader the types its XAML names. Doing that with regex meant reimplementing C#'s
             lexer, and every literal form, comment and directive it did not model was a chance to
             report a declaration that is not there. The compiler's own parser models all of them.

             Taken from the SDK rather than from a package because nuget.config lists one remote
             feed, and that feed serves only the versions already saved on it. A PackageReference
             for any Roslyn newer than the one the source generator pins therefore restores from a
             developer's local cache and then fails in CI, where there is no cache to hide it. The
             SDK building this project ships the compiler it builds with, so the parser is present
             before restore runs and is at least as new as the language the samples are written in.

             The path is spelled from NetCoreRoot and NETCoreSdkVersion because those two agree
             across MSBuild hosts. RoslynTargetsPath does not: dotnet resolves it to the directory
             holding bincore, Visual Studio's MSBuild to the binfx beside it. -->
        <Reference Include="Microsoft.CodeAnalysis"
                   HintPath="$(NetCoreRoot)sdk\$(NETCoreSdkVersion)\Roslyn\bincore\Microsoft.CodeAnalysis.dll"
                   Private="true" />
        <Reference Include="Microsoft.CodeAnalysis.CSharp"
                   HintPath="$(NetCoreRoot)sdk\$(NETCoreSdkVersion)\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll"
                   Private="true" />
    </ItemGroup>

</Project>
