<Page
    x:Class="WinUIGallery.ControlPages.TableViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Sort rows by selecting a column header"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewSorting.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <tabular:TableView
                        x:Name="SortingTable"
                        Height="300"
                        AutomationProperties.Name="Employees, sortable by column"
                        CanUserSortColumns="True"
                        ItemsSource="{x:Bind SortingEmployees}"
                        Sorted="SortingTable_Sorted">
                        <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                        <tabular:TableViewTextColumn
                            Header="Performance"
                            Binding="{Binding Performance}"
                            SortCycle="DescendingAscendingNone"
                            Width="130" />
                        <tabular:TableViewTextColumn
                            Header="Notes"
                            Binding="{Binding Notes}"
                            CanSort="False"
                            Width="*" />
                    </tabular:TableView>
                    <TextBlock
                        x:Name="SortingOutput"
                        AutomationProperties.LiveSetting="Polite"
                        Text="Select a column header to sort." />
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <Button
                    AutomationProperties.Name="Clear sort"
                    Click="ClearSort_Click"
                    Content="Clear sort" />
            </controls:ControlExample.Options>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Filter rows as you type"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewFiltering.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBox
                        x:Name="FilterBox"
                        Width="320"
                        HorizontalAlignment="Left"
                        Header="Filter by name, role, or department"
                        PlaceholderText="For example, engineer"
                        TextChanged="FilterBox_TextChanged" />
                    <tabular:TableView
                        x:Name="FilteringTable"
                        Height="300"
                        AutomationProperties.Name="Employees filtered by search text">
                        <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Group rows by department or location"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewGrouping.txt">
            <controls:ControlExample.Example>
                <tabular:TableView
                    x:Name="GroupingTable"
                    Height="360"
                    AutomationProperties.Name="Employees grouped by the selected key">
                    <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                    <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                    <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                </tabular:TableView>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="GroupByComboBox"
                        Header="Group by"
                        SelectedIndex="1"
                        SelectionChanged="GroupByComboBox_SelectionChanged">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="Department" />
                        <ComboBoxItem Content="Location" />
                    </ComboBox>
                    <Button Click="ExpandAllGroups_Click" Content="Expand all" />
                    <Button Click="CollapseAllGroups_Click" Content="Collapse all" />
                </StackPanel>
            </controls:ControlExample.Options>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Resize columns by dragging the header edge"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewColumnResizing.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Name sizes to its content, Role is 200 pixels wide (120 to 320), Department can't be resized, and Notes fills the remaining space."
                        TextWrapping="Wrap" />
                    <tabular:TableView
                        Height="300"
                        AutomationProperties.Name="Employees with resizable columns"
                        CanUserResizeColumns="{x:Bind ResizeToggle.IsOn, Mode=OneWay}"
                        ItemsSource="{x:Bind ResizingEmployees}">
                        <tabular:TableViewTextColumn
                            Header="Name"
                            Binding="{Binding Name}"
                            MinWidth="120"
                            Width="Auto" />
                        <tabular:TableViewTextColumn
                            Header="Role"
                            Binding="{Binding Role}"
                            MaxWidth="320"
                            MinWidth="120"
                            Width="200" />
                        <tabular:TableViewTextColumn
                            Header="Department"
                            Binding="{Binding Department}"
                            CanResize="False"
                            Width="140" />
                        <tabular:TableViewTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="ResizeToggle"
                    Header="Allow column resizing"
                    IsOn="True" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="CanUserResizeColumns" Value="{x:Bind ResizeToggle.IsOn, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Show tooltips on headers and cells"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewToolTips.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Hover over a column header to see its description. Hover over a Name cell to see the employee's email address."
                        TextWrapping="Wrap" />
                    <tabular:TableView
                        Height="300"
                        AutomationProperties.Name="Employees with header and cell tooltips"
                        ItemsSource="{x:Bind ToolTipEmployees}">
                        <tabular:TableViewTextColumn
                            Header="Name"
                            Binding="{Binding Name}"
                            CellToolTipBinding="{Binding Email}"
                            HeaderToolTip="Full name. Hover over a cell to see the email address."
                            Width="*" />
                        <tabular:TableViewTextColumn
                            Header="Role"
                            Binding="{Binding Role}"
                            HeaderToolTip="Current job title"
                            Width="*" />
                        <tabular:TableViewTextColumn
                            Header="Notes"
                            Binding="{Binding Notes}"
                            CellToolTipBinding="{Binding Notes}"
                            HeaderToolTip="Latest note from the manager"
                            Width="*" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Edit cells in place"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewEditing.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Double-click a cell or press F2 to edit. Press Enter to commit or Esc to cancel. ID is read-only."
                            TextWrapping="Wrap" />
                        <tabular:TableView
                            x:Name="EditingTable"
                            Height="300"
                            AutomationProperties.Name="Editable employees"
                            CellEditEnding="EditingTable_CellEditEnding"
                            IsReadOnly="False"
                            ItemsSource="{x:Bind EditingEmployees}">
                            <tabular:TableViewTextColumn
                                Header="ID"
                                Binding="{Binding Id}"
                                IsReadOnly="True"
                                Width="100" />
                            <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                            <tabular:TableViewTemplateColumn Header="Notes" Width="*">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Notes}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                                <tabular:TableViewTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Notes"
                                            Text="{Binding Notes, Mode=TwoWay}" />
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellEditingTemplate>
                            </tabular:TableViewTemplateColumn>
                        </tabular:TableView>
                    </StackPanel>
                    <TextBlock
                        x:Name="EditingOutput"
                        AutomationProperties.LiveSetting="Polite"
                        Text="No edits yet." />
                </StackPanel>
            </controls:ControlExample.Example>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Customize cells with a DataTemplate"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewCellTemplates.txt">
            <controls:ControlExample.Example>
                <tabular:TableView
                    Height="360"
                    AutomationProperties.Name="Employees with custom cell templates"
                    ItemsSource="{x:Bind TemplateEmployees}">
                    <tabular:TableViewTemplateColumn
                        Header="Employee"
                        SortMemberPath="Name"
                        Width="*">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Padding="12,6"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <PersonPicture
                                        Width="32"
                                        Height="32"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Initials="{Binding Initials}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{Binding Email}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="140" />
                    <tabular:TableViewTemplateColumn
                        Header="Performance"
                        SortMemberPath="Performance"
                        Width="200">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Padding="12,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Performance"
                                        Maximum="100"
                                        Value="{Binding PerformanceValue}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding Performance}" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                </tabular:TableView>
            </controls:ControlExample.Example>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Keep the first column visible while scrolling horizontally"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewFrozenColumns.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBlock Text="Scroll the table horizontally. The Name column stays in place." TextWrapping="Wrap" />
                    <tabular:TableView
                        Height="300"
                        AutomationProperties.Name="Employees with a frozen name column"
                        ItemsSource="{x:Bind FrozenEmployees}">
                        <tabular:TableViewTextColumn
                            x:Name="FrozenNameColumn"
                            Header="Name"
                            Binding="{Binding Name}"
                            FrozenEdge="Leading"
                            Width="170" />
                        <tabular:TableViewTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                        <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="220" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="160" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="160" />
                        <tabular:TableViewTextColumn Header="Email" Binding="{Binding Email}" Width="260" />
                        <tabular:TableViewTextColumn Header="Notes" Binding="{Binding Notes}" Width="280" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="FreezeToggle"
                    Header="Freeze the Name column"
                    IsOn="True"
                    Toggled="FreezeToggle_Toggled" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="FrozenEdge" Value="{x:Bind FrozenNameColumn.FrozenEdge, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Choose which grid lines to show"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewGridLines.txt">
            <controls:ControlExample.Example>
                <tabular:TableView
                    x:Name="GridLinesTable"
                    Height="300"
                    AutomationProperties.Name="Employees with configurable grid lines"
                    GridLinesVisibility="All"
                    ItemsSource="{x:Bind GridLinesEmployees}">
                    <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                    <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                    <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                </tabular:TableView>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ComboBox
                    x:Name="GridLinesComboBox"
                    Header="Grid lines"
                    SelectedIndex="0"
                    SelectionChanged="GridLinesComboBox_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="All" />
                    <ComboBoxItem Content="Horizontal" Tag="Horizontal" />
                    <ComboBoxItem Content="Vertical" Tag="Vertical" />
                    <ComboBoxItem Content="None" Tag="None" />
                </ComboBox>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="GridLinesVisibility" Value="{x:Bind GridLinesTable.GridLinesVisibility, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Show custom content when the table has no rows"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewEmptyTemplate.txt">
            <controls:ControlExample.Example>
                <tabular:TableView
                    Height="300"
                    AutomationProperties.Name="Employees, with an empty state"
                    ItemsSource="{x:Bind EmptyStateEmployees}">
                    <tabular:TableView.EmptyTemplate>
                        <DataTemplate>
                            <StackPanel
                                Padding="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="32"
                                    Glyph="&#xE716;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="No employees to show" />
                            </StackPanel>
                        </DataTemplate>
                    </tabular:TableView.EmptyTemplate>
                    <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                    <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                    <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                </tabular:TableView>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="EmptyStateToggle"
                    Header="Remove all rows"
                    IsOn="False"
                    Toggled="EmptyStateToggle_Toggled" />
            </controls:ControlExample.Options>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Select a row"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableView\TableViewSelection.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <tabular:TableView
                        x:Name="SelectionTable"
                        Height="300"
                        AutomationProperties.Name="Selectable employees"
                        ItemsSource="{x:Bind SelectionEmployees}"
                        SelectionChanged="SelectionTable_SelectionChanged"
                        SelectionMode="Single">
                        <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                    </tabular:TableView>
                    <TextBlock
                        x:Name="SelectionOutput"
                        AutomationProperties.LiveSetting="Polite"
                        Text="No row selected." />
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="SelectionModeComboBox"
                        Header="Selection mode"
                        SelectedIndex="0"
                        SelectionChanged="SelectionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Single" Tag="Single" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                    <Button Click="SelectFirstRow_Click" Content="Select first row" />
                    <Button Click="DeselectAll_Click" Content="Clear selection" />
                </StackPanel>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="SelectionMode" Value="{x:Bind SelectionTable.SelectionMode, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
