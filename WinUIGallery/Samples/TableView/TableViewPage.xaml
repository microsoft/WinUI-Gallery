<Page
    x:Class="WinUIGallery.ControlPages.TableViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:local="using:WinUIGallery.ControlPages"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel Margin="0,16,0,0" Spacing="16">
        <TextBlock
            Text="Before using TableView, add TabularControlsResources to the merged resource dictionaries in App.xaml, after XamlControlsResources:"
            TextWrapping="Wrap" />
        <controls:SampleCodePresenter
            AutomationProperties.AutomationId="TableViewResourceCode"
            IsCopyButtonVisible="True"
            SampleType="XAML">
            <controls:SampleCodePresenter.Code>
                <x:String xml:space="preserve">&lt;Application.Resources&gt;
    &lt;ResourceDictionary&gt;
        &lt;ResourceDictionary.MergedDictionaries&gt;
            &lt;XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /&gt;
            &lt;TabularControlsResources xmlns="using:Microsoft.UI.Xaml.Controls.Tabular" /&gt;
        &lt;/ResourceDictionary.MergedDictionaries&gt;
    &lt;/ResourceDictionary&gt;
&lt;/Application.Resources&gt;</x:String>
            </controls:SampleCodePresenter.Code>
        </controls:SampleCodePresenter>

        <controls:ControlExample
            SampleDefinition="TableView\BasicTable.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Bind a collection to ItemsSource and define its columns. Select a header to sort or a row to select it. Drag a header's edge to resize. Freeze the first column and scroll horizontally to keep ID visible."
                    TextWrapping="Wrap" />
                <tabular:TableView
                    x:Name="BasicTable"
                    Height="280"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="TableViewBasicTable"
                    AutomationProperties.Name="Basic table"
                    CanUserResizeColumns="{x:Bind ResizeColumnsToggle.IsOn, Mode=OneWay}"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind BasicItems}"
                    SelectionChanged="BasicTable_SelectionChanged"
                    SelectionMode="Single"
                    Sorted="BasicTable_Sorted">
                    <tabular:TableView.Columns>
                        <tabular:TableViewTextColumn
                            x:Name="BasicIdColumn"
                            Binding="{Binding Id}"
                            CanResize="False"
                            CanSort="False"
                            FrozenEdge="Leading"
                            Header="ID"
                            Width="80" />
                        <tabular:TableViewTextColumn
                            Binding="{Binding Name}"
                            Header="Name"
                            SortCycle="AscendingDescendingNone"
                            Width="220" />
                        <tabular:TableViewTextColumn
                            Binding="{Binding Category}"
                            Header="Category"
                            SortCycle="AscendingDescendingNone"
                            Width="180" />
                        <tabular:TableViewTextColumn
                            Binding="{Binding Value}"
                            Header="Value"
                            SortCycle="DescendingAscendingNone"
                            Width="140" />
                    </tabular:TableView.Columns>
                </tabular:TableView>
                <TextBlock
                    Text="ID cannot be sorted or resized. Value sorts largest first; the third click restores source order."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SortStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Text="Rows are in source order."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SelectionStatusText"
                    AutomationProperties.LiveSetting="Polite"
                    Text="No row selected."
                    TextWrapping="Wrap" />
            </StackPanel>
            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="SelectionModeComboBox"
                        AutomationProperties.AutomationId="TableViewSelectionModeSelector"
                        AutomationProperties.Name="Row selection mode"
                        Header="Selection mode"
                        SelectedIndex="0"
                        SelectionChanged="SelectionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Single" Tag="Single" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="ResizeColumnsToggle"
                        AutomationProperties.AutomationId="TableViewResizeColumnsToggle"
                        AutomationProperties.Name="Allow column resizing"
                        Header="Column resizing"
                        IsOn="True"
                        OffContent="Disabled"
                        OnContent="Enabled" />
                    <ToggleSwitch
                        x:Name="FreezeFirstColumnToggle"
                        AutomationProperties.AutomationId="TableViewFreezeFirstColumnToggle"
                        AutomationProperties.Name="Freeze the ID column"
                        Header="First column"
                        IsOn="True"
                        OffContent="Scrollable"
                        OnContent="Frozen"
                        Toggled="FreezeFirstColumnToggle_Toggled" />
                </StackPanel>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution
                    Key="SelectionMode"
                    Value="{x:Bind ((ComboBoxItem)SelectionModeComboBox.SelectedItem).Tag, Mode=OneWay}" />
                <controls:ControlExampleSubstitution
                    Key="CanUserResizeColumns"
                    Value="{x:Bind ResizeColumnsToggle.IsOn, Mode=OneWay}" />
                <controls:ControlExampleSubstitution
                    Key="FrozenEdge"
                    Value="{x:Bind BasicIdColumn.FrozenEdge, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>

        <controls:ControlExample
            SampleDefinition="TableView\FilteringGroupingTable.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Use one TableViewSource to filter and group the same collection. Filter by name or category, then change the grouping without clearing the filter."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="FilterBox"
                    Width="300"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="TableViewFilterBox"
                    AutomationProperties.Name="Filter by name or category"
                    Header="Filter by name or category"
                    PlaceholderText="Try Alpha or Item 2"
                    TextChanged="FilterBox_TextChanged" />
                <tabular:TableView
                    x:Name="FilteringGroupingTable"
                    Height="320"
                    MaxWidth="480"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="TableViewFilteringGroupingTable"
                    AutomationProperties.Name="Filtered and grouped items"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="False"
                    IsReadOnly="True"
                    SelectionMode="None">
                    <tabular:TableView.EmptyTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="No items match the filter." />
                        </DataTemplate>
                    </tabular:TableView.EmptyTemplate>
                    <tabular:TableView.Columns>
                        <tabular:TableViewTextColumn Binding="{Binding Name}" Header="Name" Width="*" />
                        <tabular:TableViewTextColumn Binding="{Binding Category}" Header="Category" Width="140" />
                        <tabular:TableViewTextColumn Binding="{Binding Value}" Header="Value" Width="100" />
                    </tabular:TableView.Columns>
                </tabular:TableView>
            </StackPanel>
            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="GroupByComboBox"
                        AutomationProperties.AutomationId="TableViewGroupBySelector"
                        AutomationProperties.Name="Group rows by"
                        Header="Group by"
                        SelectedIndex="1"
                        SelectionChanged="GroupByComboBox_SelectionChanged">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="Category" />
                    </ComboBox>
                    <Button
                        AutomationProperties.AutomationId="TableViewExpandAllGroupsButton"
                        AutomationProperties.Name="Expand all groups"
                        Click="ExpandAllGroups_Click"
                        Content="Expand all groups" />
                    <Button
                        AutomationProperties.AutomationId="TableViewCollapseAllGroupsButton"
                        AutomationProperties.Name="Collapse all groups"
                        Click="CollapseAllGroups_Click"
                        Content="Collapse all groups" />
                </StackPanel>
            </controls:ControlExample.Options>
        </controls:ControlExample>

        <controls:ControlExample
            SampleDefinition="TableView\CustomColumnsTable.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Combine a text column with custom cells: an avatar and two lines of text, a status badge, a progress bar, and a read-only rating. SortMemberPath lets template columns sort by their underlying values."
                    TextWrapping="Wrap" />
                <tabular:TableView
                    Height="340"
                    MaxWidth="900"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="TableViewCustomColumnsTable"
                    AutomationProperties.Name="Table with custom cell templates"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="True"
                    GridLinesVisibility="None"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind CustomColumnItems}"
                    SelectionMode="None">
                    <tabular:TableView.Columns>
                        <tabular:TableViewTextColumn Binding="{Binding Id}" Header="ID" Width="64" />
                        <tabular:TableViewTemplateColumn
                            CellToolTipBinding="{Binding Name}"
                            Header="Item"
                            HeaderToolTip="The item's name and category"
                            SortMemberPath="Name"
                            Width="200">
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:TableViewSampleItem">
                                    <StackPanel
                                        Padding="12,6"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <PersonPicture
                                            Width="32"
                                            Height="32"
                                            AutomationProperties.AccessibilityView="Raw"
                                            DisplayName="{x:Bind Name, Mode=OneWay}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Category, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn Header="Status" SortMemberPath="Status" Width="120">
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:TableViewSampleItem">
                                    <Border
                                        Margin="12,0"
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Status}" />
                                    </Border>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn Header="Value" SortMemberPath="Value" Width="220">
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:TableViewSampleItem">
                                    <Grid Padding="12,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            IsHitTestVisible="False"
                                            Maximum="100"
                                            Value="{x:Bind Value}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                        <tabular:TableViewTemplateColumn Header="Rating" SortMemberPath="Rating" Width="180">
                            <tabular:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="local:TableViewSampleItem">
                                    <RatingControl
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Item rating"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        MaxRating="5"
                                        Value="{x:Bind Rating}" />
                                </DataTemplate>
                            </tabular:TableViewTemplateColumn.CellTemplate>
                        </tabular:TableViewTemplateColumn>
                    </tabular:TableView.Columns>
                </tabular:TableView>
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            SampleDefinition="TableView\EditingCellsTable.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Double-click a Name or Category cell, or press F2, to edit. Press Enter to save or Esc to cancel. ID is always read-only. Clear a name to try INotifyDataErrorInfo validation, or make the whole table read-only."
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="ValidationInfoBar"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.Name="Cell validation feedback"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Invalid value" />
                <tabular:TableView
                    x:Name="EditingTable"
                    Height="260"
                    AutomationProperties.AutomationId="TableViewEditingCellsTable"
                    AutomationProperties.Name="Editable cells"
                    BeginningEdit="EditingTable_BeginningEdit"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="False"
                    CellEditEnding="EditingTable_CellEditEnding"
                    IsReadOnly="{x:Bind ReadOnlyToggle.IsOn, Mode=OneWay}"
                    ItemsSource="{x:Bind EditingItems}"
                    SelectionMode="Single"
                    Unloaded="EditingTable_Unloaded">
                    <tabular:TableView.Columns>
                        <tabular:TableViewTextColumn
                            Binding="{Binding Id}"
                            Header="ID"
                            IsReadOnly="True"
                            Width="80" />
                        <tabular:TableViewTextColumn Binding="{Binding Name}" Header="Name" Width="180" />
                        <tabular:TableViewTextColumn Binding="{Binding Category}" Header="Category" Width="180" />
                    </tabular:TableView.Columns>
                </tabular:TableView>
            </StackPanel>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="ReadOnlyToggle"
                    AutomationProperties.AutomationId="TableViewReadOnlyToggle"
                    AutomationProperties.Name="Make the table read-only"
                    Header="Read-only"
                    IsOn="False"
                    OffContent="Editable"
                    OnContent="Read-only" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution
                    Key="IsReadOnly"
                    Value="{x:Bind ReadOnlyToggle.IsOn, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>

        <controls:ControlExample
            SampleDefinition="TableView\PresentationTable.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Change density and grid lines, or clear the collection to show EmptyTemplate. Alternating row backgrounds help distinguish rows. This table has 1,000 items; only rows near the viewport are realized."
                    TextWrapping="Wrap" />
                <tabular:TableView
                    x:Name="PresentationTable"
                    Height="320"
                    AutomationProperties.AutomationId="TableViewPresentationTable"
                    AutomationProperties.Name="Advanced table presentation and empty state"
                    AlternatingRowBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CanUserResizeColumns="False"
                    CanUserSortColumns="False"
                    Density="Standard"
                    GridLinesVisibility="All"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind PresentationItems}"
                    RowBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    SelectionMode="None">
                    <tabular:TableView.EmptyTemplate>
                        <DataTemplate>
                            <StackPanel
                                Padding="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="32"
                                    Glyph="&#xE9D9;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="No items" />
                                <TextBlock
                                    MaxWidth="320"
                                    HorizontalAlignment="Center"
                                    Text="Turn off the empty-state option to restore 1,000 items."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </tabular:TableView.EmptyTemplate>
                    <tabular:TableView.Columns>
                        <tabular:TableViewTextColumn Binding="{Binding Id}" Header="ID" Width="80" />
                        <tabular:TableViewTextColumn Binding="{Binding Name}" Header="Name" Width="180" />
                        <tabular:TableViewTextColumn Binding="{Binding Category}" Header="Category" Width="140" />
                        <tabular:TableViewTextColumn Binding="{Binding Value}" Header="Value" Width="100" />
                    </tabular:TableView.Columns>
                </tabular:TableView>
            </StackPanel>

            <controls:ControlExample.Options>
                <StackPanel Width="240" Spacing="12">
                    <ComboBox
                        x:Name="DensityComboBox"
                        AutomationProperties.AutomationId="TableViewDensitySelector"
                        AutomationProperties.Name="Table density"
                        Header="Density"
                        SelectedIndex="1"
                        SelectionChanged="DensityComboBox_SelectionChanged">
                        <ComboBoxItem Content="Compact" Tag="Compact" />
                        <ComboBoxItem Content="Standard" Tag="Standard" />
                        <ComboBoxItem Content="Comfortable" Tag="Comfortable" />
                    </ComboBox>
                    <ComboBox
                        x:Name="GridLinesComboBox"
                        AutomationProperties.AutomationId="TableViewGridLinesSelector"
                        AutomationProperties.Name="Table grid lines"
                        Header="Grid lines"
                        SelectedIndex="0"
                        SelectionChanged="GridLinesComboBox_SelectionChanged">
                        <ComboBoxItem Content="All" Tag="All" />
                        <ComboBoxItem Content="Horizontal" Tag="Horizontal" />
                        <ComboBoxItem Content="Vertical" Tag="Vertical" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="EmptyStateToggle"
                        AutomationProperties.AutomationId="TableViewEmptyStateToggle"
                        AutomationProperties.Name="Show the table empty state"
                        Header="Data"
                        IsOn="False"
                        OffContent="1,000 items"
                        OnContent="Empty state"
                        Toggled="EmptyStateToggle_Toggled" />
                </StackPanel>
            </controls:ControlExample.Options>

            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution
                    Key="Density"
                    Value="{x:Bind ((ComboBoxItem)DensityComboBox.SelectedItem).Tag, Mode=OneWay}" />
                <controls:ControlExampleSubstitution
                    Key="GridLinesVisibility"
                    Value="{x:Bind ((ComboBoxItem)GridLinesComboBox.SelectedItem).Tag, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>