<Page
    x:Class="WinUIGallery.ControlPages.TableViewFrozenColumnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Keep the first column visible while scrolling horizontally"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableViewFrozenColumns\TableViewFrozenColumns.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBlock Text="Scroll the table horizontally. The Name column stays in place." TextWrapping="Wrap" />
                    <tabular:TableView
                        Height="300"
                        AutomationProperties.Name="Employees with a frozen name column"
                        ItemsSource="{x:Bind FrozenEmployees}">
                        <tabular:TableViewTextColumn
                            x:Name="FrozenNameColumn"
                            Header="Name"
                            Binding="{Binding Name}"
                            FrozenEdge="Leading"
                            Width="170" />
                        <tabular:TableViewTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                        <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="220" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="160" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="160" />
                        <tabular:TableViewTextColumn Header="Email" Binding="{Binding Email}" Width="260" />
                        <tabular:TableViewTextColumn Header="Notes" Binding="{Binding Notes}" Width="280" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="FreezeToggle"
                    Header="Freeze the Name column"
                    IsOn="True"
                    Toggled="FreezeToggle_Toggled" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="FrozenEdge" Value="{x:Bind FrozenNameColumn.FrozenEdge, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
