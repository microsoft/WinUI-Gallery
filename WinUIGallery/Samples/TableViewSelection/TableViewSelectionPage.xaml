<Page
    x:Class="WinUIGallery.ControlPages.TableViewSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Select a row"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableViewSelection\TableViewSelection.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <tabular:TableView
                        x:Name="SelectionTable"
                        Height="300"
                        AutomationProperties.Name="Selectable employees"
                        ItemsSource="{x:Bind SelectionEmployees}"
                        SelectionChanged="SelectionTable_SelectionChanged"
                        SelectionMode="Single">
                        <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                        <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                        <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                    </tabular:TableView>
                    <TextBlock
                        x:Name="SelectionOutput"
                        AutomationProperties.LiveSetting="Polite"
                        Text="No row selected." />
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="SelectionModeComboBox"
                        Header="Selection mode"
                        SelectedIndex="0"
                        SelectionChanged="SelectionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Single" Tag="Single" />
                        <ComboBoxItem Content="None" Tag="None" />
                    </ComboBox>
                    <Button Click="SelectFirstRow_Click" Content="Select first row" />
                    <Button Click="DeselectAll_Click" Content="Clear selection" />
                </StackPanel>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="SelectionMode" Value="{x:Bind SelectionTable.SelectionMode, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
