<Page
    x:Class="WinUIGallery.ControlPages.TableViewEditingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Edit cells in place"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableViewEditing\TableViewEditing.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Double-click a cell or press F2 to edit. Press Enter to commit or Esc to cancel. ID is read-only."
                            TextWrapping="Wrap" />
                        <tabular:TableView
                            x:Name="EditingTable"
                            Height="300"
                            AutomationProperties.Name="Editable employees"
                            CellEditEnding="EditingTable_CellEditEnding"
                            IsReadOnly="False"
                            ItemsSource="{x:Bind EditingEmployees}">
                            <tabular:TableViewTextColumn
                                Header="ID"
                                Binding="{Binding Id}"
                                IsReadOnly="True"
                                Width="100" />
                            <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                            <tabular:TableViewTemplateColumn Header="Notes" Width="*">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Notes}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                                <tabular:TableViewTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Notes"
                                            Text="{Binding Notes, Mode=TwoWay}" />
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellEditingTemplate>
                            </tabular:TableViewTemplateColumn>
                        </tabular:TableView>
                    </StackPanel>
                    <TextBlock
                        x:Name="EditingOutput"
                        AutomationProperties.LiveSetting="Polite"
                        Text="No edits yet." />
                </StackPanel>
            </controls:ControlExample.Example>
        </controls:ControlExample>
    </StackPanel>
</Page>
