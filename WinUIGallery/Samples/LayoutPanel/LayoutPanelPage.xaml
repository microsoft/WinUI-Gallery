<Page
    x:Class="WinUIGallery.ControlPages.LayoutPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:layouts="using:WinUIGallery.Layouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Use a custom Layout with panel children"
            SampleDefinition="LayoutPanel\LayoutPanelCustomLayout.txt">
            <LayoutPanel
                x:Name="LayoutPanel1"
                MaxWidth="560"
                HorizontalAlignment="Stretch"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="12">
                <LayoutPanel.Layout>
                    <layouts:FeaturedTileLayout Spacing="8" />
                </LayoutPanel.Layout>

                <Border
                    Height="96"
                    Padding="16"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Featured item" />
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Text="The first child spans the available width." />
                    </StackPanel>
                </Border>
                <Border
                    Height="72"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Second" />
                </Border>
                <Border
                    Height="92"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Third (taller)" />
                </Border>
                <Border
                    Height="80"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Fourth" />
                </Border>
                <Border
                    Height="64"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Fifth" />
                </Border>
                <Border
                    Height="88"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Sixth (taller)" />
                </Border>
                <Border
                    Height="68"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Seventh" />
                </Border>
                <Border
                    Height="76"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Eighth" />
                </Border>
                <Border
                    Height="96"
                    Padding="12"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock VerticalAlignment="Center" Text="Ninth (taller)" />
                </Border>
            </LayoutPanel>

            <controls:ControlExample.Options>
                <StackPanel Spacing="12">
                    <RadioButtons
                        AutomationProperties.AutomationId="LayoutPanelLayoutSelector"
                        AutomationProperties.Name="LayoutPanel layout"
                        Header="Layout"
                        SelectionChanged="LayoutButtons_SelectionChanged">
                        <RadioButton
                            AutomationProperties.AutomationId="LayoutPanelFeaturedLayout"
                            AutomationProperties.Name="Featured tile layout"
                            Content="Featured tile"
                            IsChecked="True"
                            Tag="Featured" />
                        <RadioButton
                            AutomationProperties.AutomationId="LayoutPanelStackLayout"
                            AutomationProperties.Name="Vertical StackLayout"
                            Content="Vertical stack"
                            Tag="Stack" />
                    </RadioButtons>
                    <Slider
                        AutomationProperties.AutomationId="LayoutPanelSpacing"
                        AutomationProperties.Name="Layout spacing"
                        Header="Spacing"
                        Maximum="24"
                        SnapsTo="Ticks"
                        StepFrequency="2"
                        TickFrequency="2"
                        Value="8"
                        ValueChanged="SpacingSlider_ValueChanged" />
                    <TextBlock
                        Text="LayoutPanel also applies its BorderBrush, BorderThickness, CornerRadius, and Padding around the layout."
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:ControlExample.Options>
        </controls:ControlExample>
    </StackPanel>
</Page>
