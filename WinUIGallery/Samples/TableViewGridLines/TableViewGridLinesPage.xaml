<Page
    x:Class="WinUIGallery.ControlPages.TableViewGridLinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Choose which grid lines to show"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableViewGridLines\TableViewGridLines.txt">
            <controls:ControlExample.Example>
                <tabular:TableView
                    x:Name="GridLinesTable"
                    Height="300"
                    AutomationProperties.Name="Employees with configurable grid lines"
                    GridLinesVisibility="All"
                    ItemsSource="{x:Bind GridLinesEmployees}">
                    <tabular:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tabular:TableViewTextColumn Header="Role" Binding="{Binding Role}" Width="*" />
                    <tabular:TableViewTextColumn Header="Department" Binding="{Binding Department}" Width="*" />
                    <tabular:TableViewTextColumn Header="Location" Binding="{Binding Location}" Width="*" />
                </tabular:TableView>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ComboBox
                    x:Name="GridLinesComboBox"
                    Header="Grid lines"
                    SelectedIndex="0"
                    SelectionChanged="GridLinesComboBox_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="All" />
                    <ComboBoxItem Content="Horizontal" Tag="Horizontal" />
                    <ComboBoxItem Content="Vertical" Tag="Vertical" />
                    <ComboBoxItem Content="None" Tag="None" />
                </ComboBox>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="GridLinesVisibility" Value="{x:Bind GridLinesTable.GridLinesVisibility, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
