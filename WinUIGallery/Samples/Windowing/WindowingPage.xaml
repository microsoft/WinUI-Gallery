<Page
    x:Class="WinUIGallery.ControlPages.WindowingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls">
    <StackPanel Margin="0,16,0,0">
        <TextBlock
            Margin="0,0,0,8"
            Text="Create top-level XAML windows and configure their client-area size. Each example opens a separate window."
            TextWrapping="Wrap" />

        <controls:ControlExample
            HeaderText="Create a top-level Window"
            SampleDefinition="Windowing\CreateMultipleWindows.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="This stable example uses AppWindow.ResizeClient to request a 500 by 500 physical-pixel client area."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="CreateWindowButton"
                    AutomationProperties.AutomationId="WindowingCreateWindow"
                    AutomationProperties.Name="Create a top-level window"
                    Click="CreateNewWindow_Click"
                    Content="Create new Window" />
            </StackPanel>
        </controls:ControlExample>

        <controls:ControlExample
            IsExperimental="True"
            SampleDefinition="Windowing\WindowSizing.txt">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Configure the initial, minimum, and maximum client-area dimensions in device-independent pixels (DIPs). The initial size must be within the minimum and maximum limits."
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="SizeValidationInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Check the window dimensions" />
                <Button
                    x:Name="OpenConfiguredWindowButton"
                    AutomationProperties.AutomationId="WindowingOpenConfiguredWindow"
                    AutomationProperties.Name="Open a window with the configured client size and constraints"
                    Click="OpenConfiguredWindow_Click"
                    Content="Open configured window" />
            </StackPanel>
            <controls:ControlExample.Options>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <NumberBox
                        x:Name="ClientWidthInput"
                        AutomationProperties.AutomationId="WindowingClientWidth"
                        AutomationProperties.Name="Client width in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="Width"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="640" />
                    <NumberBox
                        x:Name="ClientHeightInput"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="WindowingClientHeight"
                        AutomationProperties.Name="Client height in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="Height"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="480" />
                    <NumberBox
                        x:Name="MinimumWidthInput"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="WindowingMinimumWidth"
                        AutomationProperties.Name="Minimum client width in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="MinWidth"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="320" />
                    <NumberBox
                        x:Name="MinimumHeightInput"
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="WindowingMinimumHeight"
                        AutomationProperties.Name="Minimum client height in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="MinHeight"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="240" />
                    <NumberBox
                        x:Name="MaximumWidthInput"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="WindowingMaximumWidth"
                        AutomationProperties.Name="Maximum client width in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="MaxWidth"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="960" />
                    <NumberBox
                        x:Name="MaximumHeightInput"
                        Grid.Row="2"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="WindowingMaximumHeight"
                        AutomationProperties.Name="Maximum client height in DIPs"
                        HorizontalAlignment="Stretch"
                        Header="MaxHeight"
                        Maximum="10000"
                        Minimum="1"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        ValidationMode="InvalidInputOverwritten"
                        Value="720" />
                </Grid>
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="Width" Value="{x:Bind ClientWidthInput.Value, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="Height" Value="{x:Bind ClientHeightInput.Value, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="MinWidth" Value="{x:Bind MinimumWidthInput.Value, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="MinHeight" Value="{x:Bind MinimumHeightInput.Value, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="MaxWidth" Value="{x:Bind MaximumWidthInput.Value, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="MaxHeight" Value="{x:Bind MaximumHeightInput.Value, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
