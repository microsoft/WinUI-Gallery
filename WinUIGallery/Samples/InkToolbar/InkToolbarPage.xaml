<Page
    x:Class="WinUIGallery.ControlPages.InkToolbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls">

    <StackPanel>
        <controls:ControlExample
            HeaderText="An ink toolbar attached to an ink canvas"
            IsExperimental="True"
            SampleDefinition="InkToolbar\InkToolbarBasic.txt">
            <controls:ControlExample.Example>
                <StackPanel HorizontalAlignment="Left" Spacing="8">
                    <InkToolbar
                        x:Name="BasicInkToolbar"
                        AutomationProperties.AutomationId="BasicInkToolbar"
                        AutomationProperties.Name="Ink toolbar"
                        TargetInkCanvas="{x:Bind BasicInkCanvas}" />
                    <Border
                        Width="400"
                        Height="300"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <InkCanvas
                            x:Name="BasicInkCanvas"
                            AutomationProperties.AutomationId="InkToolbarInkCanvas"
                            AutomationProperties.Name="Drawing surface" />
                    </Border>
                </StackPanel>
            </controls:ControlExample.Example>

            <controls:ControlExample.Options>
                <StackPanel Width="220" Spacing="12">
                    <ComboBox
                        x:Name="OrientationComboBox"
                        AutomationProperties.Name="Toolbar orientation"
                        Header="Orientation"
                        SelectedIndex="0"
                        SelectionChanged="ToolbarOption_Changed">
                        <x:String>Horizontal</x:String>
                        <x:String>Vertical</x:String>
                    </ComboBox>

                    <Button
                        x:Name="ClearAllButton"
                        AutomationProperties.Name="Clear all strokes"
                        Click="ClearAllButton_Click"
                        Content="Clear all" />
                </StackPanel>
            </controls:ControlExample.Options>

            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="Orientation" Value="{x:Bind OrientationName, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
