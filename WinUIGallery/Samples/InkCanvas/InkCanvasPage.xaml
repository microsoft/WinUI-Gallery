<Page
    x:Class="WinUIGallery.ControlPages.InkCanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls">

    <StackPanel>
        <controls:ControlExample
            HeaderText="A basic ink canvas"
            IsExperimental="True"
            SampleDefinition="InkCanvas\InkCanvasBasic.txt">
            <controls:ControlExample.Example>
                <Border
                    Width="400"
                    Height="300"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <InkCanvas
                        x:Name="BasicInkCanvas"
                        AutomationProperties.AutomationId="BasicInkCanvas"
                        AutomationProperties.Name="Drawing surface" />
                </Border>
            </controls:ControlExample.Example>

            <controls:ControlExample.Options>
                <StackPanel Width="220" Spacing="12">
                    <ComboBox
                        x:Name="PenColorComboBox"
                        AutomationProperties.Name="Pen color"
                        Header="Pen color"
                        SelectedIndex="0"
                        SelectionChanged="PenOption_Changed">
                        <x:String>Black</x:String>
                        <x:String>Red</x:String>
                        <x:String>Blue</x:String>
                        <x:String>Green</x:String>
                    </ComboBox>

                    <Slider
                        x:Name="StrokeSizeSlider"
                        AutomationProperties.Name="Stroke size"
                        Header="Stroke size"
                        IsFocusEngagementEnabled="False"
                        Maximum="20"
                        Minimum="1"
                        Value="5"
                        ValueChanged="StrokeSizeSlider_ValueChanged" />

                    <CheckBox
                        x:Name="HighlighterCheckBox"
                        AutomationProperties.Name="Draw as highlighter"
                        Checked="PenOption_Changed"
                        Content="Draw as highlighter"
                        Unchecked="PenOption_Changed" />

                    <RadioButtons AutomationProperties.Name="Pen tip" Header="Pen tip">
                        <RadioButton
                            x:Name="CirclePenTipRadioButton"
                            AutomationProperties.Name="Circle pen tip"
                            Checked="PenOption_Changed"
                            Content="Circle"
                            IsChecked="True" />
                        <RadioButton
                            AutomationProperties.Name="Rectangle pen tip"
                            Checked="PenOption_Changed"
                            Content="Rectangle" />
                    </RadioButtons>

                    <Button
                        x:Name="ClearAllButton"
                        AutomationProperties.Name="Clear all strokes"
                        Click="ClearAllButton_Click"
                        Content="Clear all" />
                </StackPanel>
            </controls:ControlExample.Options>

            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="PenColor" Value="{x:Bind PenColorName, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="StrokeSize" Value="{x:Bind StrokeSizeText, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="DrawAsHighlighter" Value="{x:Bind DrawAsHighlighterText, Mode=OneWay}" />
                <controls:ControlExampleSubstitution Key="PenTip" Value="{x:Bind PenTipName, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
