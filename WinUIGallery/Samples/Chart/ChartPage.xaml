<Page
    x:Class="WinUIGallery.ControlPages.ChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Microsoft.UI.Xaml.Controls.Charts"
    xmlns:controls="using:WinUIGallery.Controls">
    <StackPanel Margin="0,16,0,0" Spacing="16">
        <controls:ControlExample
            HeaderText="Create a line chart with axes and a legend"
            SampleDefinition="Chart\BasicLineChart.txt">
            <charts:Chart
                Height="320"
                AutomationProperties.AutomationId="ChartBasicLine"
                AutomationProperties.HelpText="Monthly profit increases from 18 in January to 52 in June."
                AutomationProperties.Name="Monthly profit line chart"
                LegendTitle="Revenue"
                ShowLegend="True">
                <charts:Chart.Data>
                    <charts:Samples
                        x:Name="Month"
                        ItemsSource="{x:Bind Months, Mode=OneTime}" />
                    <charts:Samples
                        x:Name="Profit"
                        ItemsSource="{x:Bind Profits, Mode=OneTime}" />
                </charts:Chart.Data>

                <charts:Chart.Axes>
                    <charts:CategoryAxis
                        x:Name="MonthX"
                        Label="Month" />
                    <charts:LinearAxis
                        x:Name="ProfitY"
                        GridLines="Major"
                        Label="Profit"
                        Minimum="0" />
                </charts:Chart.Axes>

                <charts:LineSeries
                    Title="2025"
                    XAxis="{x:Bind MonthX, Mode=OneTime}"
                    XValues="{x:Bind Month, Mode=OneTime}"
                    YAxis="{x:Bind ProfitY, Mode=OneTime}"
                    YValues="{x:Bind Profit, Mode=OneTime}" />
            </charts:Chart>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Style area, bar, and line series"
            SampleDefinition="Chart\StyledSeries.txt">
            <charts:Chart
                Height="360"
                AutomationProperties.AutomationId="ChartStyledSeries"
                AutomationProperties.HelpText="Forecast, actual, and target monthly results. The March target is highlighted as the peak."
                AutomationProperties.Name="Monthly results chart with area, bar, and line series"
                LegendTitle="Monthly results"
                ShowLegend="True">
                <charts:Chart.Data>
                    <charts:Samples
                        x:Name="StyledMonth"
                        ItemsSource="{x:Bind Months, Mode=OneTime}" />
                    <charts:Samples
                        x:Name="Actual"
                        ItemsSource="{x:Bind Actuals, Mode=OneTime}" />
                    <charts:Samples
                        x:Name="Forecast"
                        ItemsSource="{x:Bind Forecasts, Mode=OneTime}" />
                    <charts:Samples
                        x:Name="Target"
                        ItemsSource="{x:Bind Targets, Mode=OneTime}" />
                </charts:Chart.Data>

                <charts:Chart.Axes>
                    <charts:CategoryAxis
                        x:Name="StyledMonthX"
                        Label="Month" />
                    <charts:LinearAxis
                        x:Name="RevenueY"
                        GridLines="Major"
                        Label="Revenue"
                        Maximum="60"
                        Minimum="0"
                        Spacing="10" />
                </charts:Chart.Axes>

                <charts:AreaSeries
                    DataMarkerBrush="Crimson"
                    Fill="LightSteelBlue"
                    MarkerShape="Square"
                    ShowDataMarkers="True"
                    Stroke="MidnightBlue"
                    StrokeDashStyle="Dot"
                    StrokeThickness="2"
                    Title="Forecast"
                    XAxis="{x:Bind StyledMonthX, Mode=OneTime}"
                    XValues="{x:Bind StyledMonth, Mode=OneTime}"
                    YAxis="{x:Bind RevenueY, Mode=OneTime}"
                    YValues="{x:Bind Forecast, Mode=OneTime}" />

                <charts:BarSeries
                    DataLabelBrush="Black"
                    Fill="SeaGreen"
                    Orientation="Vertical"
                    ShowDataLabels="True"
                    Stroke="Black"
                    StrokeThickness="1"
                    Title="Actual"
                    XAxis="{x:Bind StyledMonthX, Mode=OneTime}"
                    XValues="{x:Bind StyledMonth, Mode=OneTime}"
                    YAxis="{x:Bind RevenueY, Mode=OneTime}"
                    YValues="{x:Bind Actual, Mode=OneTime}" />

                <charts:LineSeries
                    x:Name="TargetSeries"
                    DataMarkerBrush="Goldenrod"
                    MarkerShape="Plus"
                    ShowDataMarkers="True"
                    Stroke="Firebrick"
                    StrokeDashStyle="Dash"
                    StrokeThickness="2"
                    Title="Target"
                    XAxis="{x:Bind StyledMonthX, Mode=OneTime}"
                    XValues="{x:Bind StyledMonth, Mode=OneTime}"
                    YAxis="{x:Bind RevenueY, Mode=OneTime}"
                    YValues="{x:Bind Target, Mode=OneTime}" />
            </charts:Chart>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Create a bar chart"
            SampleDefinition="Chart\BarChart.txt">
            <charts:Chart
                Height="320"
                AutomationProperties.AutomationId="ChartBar"
                AutomationProperties.HelpText="Units sold are 42 in North, 38 in South, 51 in East, and 47 in West."
                AutomationProperties.Name="Units sold by region bar chart">
                <charts:Chart.Data>
                    <charts:Samples
                        x:Name="Region"
                        ItemsSource="{x:Bind Regions, Mode=OneTime}" />
                    <charts:Samples
                        x:Name="Units"
                        ItemsSource="{x:Bind UnitsSold, Mode=OneTime}" />
                </charts:Chart.Data>

                <charts:BarSeries
                    Fill="SeaGreen"
                    Orientation="Vertical"
                    Title="Units sold"
                    XValues="{x:Bind Region, Mode=OneTime}"
                    YValues="{x:Bind Units, Mode=OneTime}" />
            </charts:Chart>
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Plot a time series"
            SampleDefinition="Chart\TimeSeries.txt">
            <charts:Chart
                x:Name="TimeSeriesChart"
                Height="320"
                AutomationProperties.AutomationId="ChartTimeSeries"
                AutomationProperties.HelpText="Weekly temperature readings plotted against a date-time axis."
                AutomationProperties.Name="Weekly temperature area chart" />
        </controls:ControlExample>

        <controls:ControlExample
            HeaderText="Update a series data source"
            SampleDefinition="Chart\LiveObservableSeries.txt">
            <StackPanel Spacing="12">
                <Button
                    AutomationProperties.AutomationId="ChartAddResponseTimeSampleButton"
                    AutomationProperties.Name="Add response time sample"
                    Click="AddResponseTimeSampleButton_Click"
                    Content="Add sample"
                    HorizontalAlignment="Left" />
                <TextBlock
                    AutomationProperties.AutomationId="ChartLiveSeriesSummary"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind LiveSeriesSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <charts:Chart
                    Height="320"
                    AutomationProperties.AutomationId="ChartLiveObservableSeries"
                    AutomationProperties.HelpText="A response-time line series that updates when Add sample is selected."
                    AutomationProperties.Name="Live response time chart">
                    <charts:Chart.Data>
                        <charts:Samples
                            x:Name="ResponseTime"
                            ItemsSource="{x:Bind ResponseTimes, Mode=OneTime}" />
                    </charts:Chart.Data>

                    <charts:Chart.Axes>
                        <charts:LinearAxis
                            x:Name="ResponseTimeY"
                            GridLines="Major"
                            Label="Milliseconds"
                            Minimum="0" />
                    </charts:Chart.Axes>

                    <charts:LineSeries
                        ShowDataMarkers="True"
                        Title="Response time"
                        YAxis="{x:Bind ResponseTimeY, Mode=OneTime}"
                        YValues="{x:Bind ResponseTime, Mode=OneTime}" />
                </charts:Chart>
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
