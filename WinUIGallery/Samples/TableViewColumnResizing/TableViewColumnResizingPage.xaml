<Page
    x:Class="WinUIGallery.ControlPages.TableViewColumnResizingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular">
    <StackPanel>
        <controls:ControlExample
            HeaderText="Resize columns by dragging the header edge"
            HorizontalContentAlignment="Stretch"
            SampleDefinition="TableViewColumnResizing\TableViewColumnResizing.txt">
            <controls:ControlExample.Example>
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Name sizes to its content, Role is 200 pixels wide (120 to 320), Department can't be resized, and Notes fills the remaining space."
                        TextWrapping="Wrap" />
                    <tabular:TableView
                        Height="300"
                        AutomationProperties.Name="Employees with resizable columns"
                        CanUserResizeColumns="{x:Bind ResizeToggle.IsOn, Mode=OneWay}"
                        ItemsSource="{x:Bind ResizingEmployees}">
                        <tabular:TableViewTextColumn
                            Header="Name"
                            Binding="{Binding Name}"
                            MinWidth="120"
                            Width="Auto" />
                        <tabular:TableViewTextColumn
                            Header="Role"
                            Binding="{Binding Role}"
                            MaxWidth="320"
                            MinWidth="120"
                            Width="200" />
                        <tabular:TableViewTextColumn
                            Header="Department"
                            Binding="{Binding Department}"
                            CanResize="False"
                            Width="140" />
                        <tabular:TableViewTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    </tabular:TableView>
                </StackPanel>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ToggleSwitch
                    x:Name="ResizeToggle"
                    Header="Allow column resizing"
                    IsOn="True" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="CanUserResizeColumns" Value="{x:Bind ResizeToggle.IsOn, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>
