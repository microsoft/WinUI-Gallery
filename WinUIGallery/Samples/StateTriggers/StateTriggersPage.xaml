<Page
    x:Class="WinUIGallery.ControlPages.StateTriggersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:local="using:WinUIGallery.ControlPages"
    Loaded="OnPageLoaded">
    <Page.Resources>
        <Style x:Key="MouseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style x:Key="TouchPenButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="BasicStates">
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="MessageBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Target="MessageText.FontWeight" Value="Normal" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Emphasized">
                    <VisualState.Setters>
                        <Setter Target="MessageBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="MessageText.FontWeight" Value="SemiBold" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WidthExample.Orientation" Value="Horizontal" />
                        <Setter Target="WindowWidthStatus.Text" Value="Side by side: window width is at least 900 epx." />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WidthExample.Orientation" Value="Vertical" />
                        <Setter Target="WindowWidthStatus.Text" Value="Stacked vertically: window width is below 900 epx." />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="InputTypeStates">
                <VisualState x:Name="MouseInput">
                    <VisualState.StateTriggers>
                        <local:InputTypeTrigger TargetElement="{x:Bind InputTarget}" PointerType="Mouse" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FirstChoice.Style" Value="{StaticResource MouseButtonStyle}" />
                        <Setter Target="SecondChoice.Style" Value="{StaticResource MouseButtonStyle}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TouchOrPenInput">
                    <VisualState.StateTriggers>
                        <local:InputTypeTrigger TargetElement="{x:Bind InputTarget}" PointerType="Touch" />
                        <local:InputTypeTrigger TargetElement="{x:Bind InputTarget}" PointerType="Pen" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FirstChoice.Style" Value="{StaticResource TouchPenButtonStyle}" />
                        <Setter Target="SecondChoice.Style" Value="{StaticResource TouchPenButtonStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel>
            <controls:ControlExample SampleDefinition="StateTriggers\VisualStatesAndSetters.txt">
                <StackPanel Spacing="16">
                    <ToggleSwitch
                        x:Name="EmphasisSwitch"
                        Header="Emphasize the message"
                        AutomationProperties.AutomationId="EmphasisSwitch"
                        AutomationProperties.Name="Emphasize the message"
                        Toggled="OnEmphasisToggled" />
                    <Border
                        x:Name="MessageBorder"
                        Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <TextBlock x:Name="MessageText" Text="Visual states change several properties together." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </controls:ControlExample>
            <controls:ControlExample SampleDefinition="StateTriggers\BuiltInAdaptiveTrigger.txt">
                <StackPanel Spacing="16">
                    <TextBlock Text="Resize the Gallery window: at 900 epx or wider, these content regions sit side by side; below 900 epx, they stack vertically. The trigger uses the whole window width, not this example's width." TextWrapping="Wrap" />
                    <StackPanel x:Name="WidthExample" Orientation="Vertical" Spacing="12">
                        <Border
                            Width="260"
                            MinHeight="128"
                            HorizontalAlignment="Left"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.AutomationId="FirstRegionHeading"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="First region" />
                                <TextBlock Text="Primary content stays together here as the window changes size." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Width="260"
                            MinHeight="128"
                            HorizontalAlignment="Left"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.AutomationId="SecondRegionHeading"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Second region" />
                                <TextBlock Text="Supporting content moves below the first region in a narrow window." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="WindowWidthStatus" TextWrapping="Wrap" />
                </StackPanel>
            </controls:ControlExample>
            <controls:ControlExample SampleDefinition="StateTriggers\CustomInputTypeTrigger.txt">
                <StackPanel Spacing="12">
                    <TextBlock Text="Press either button using a mouse, touch or pen. Touch and pen activate the same state (OR). Keyboard activation does not change the last pointer type." TextWrapping="Wrap" />
                    <Border
                        x:Name="InputTarget"
                        Padding="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Loaded="OnInputTargetLoaded"
                        Unloaded="OnInputTargetUnloaded">
                        <StackPanel>
                            <Button
                                x:Name="FirstChoice"
                                Content="First option"
                                AutomationProperties.AutomationId="FirstInputChoice"
                                AutomationProperties.Name="First option"
                                Style="{StaticResource MouseButtonStyle}"
                                Click="OnChoiceClicked" />
                            <Button
                                x:Name="SecondChoice"
                                Content="Second option"
                                AutomationProperties.AutomationId="SecondInputChoice"
                                AutomationProperties.Name="Second option"
                                Style="{StaticResource MouseButtonStyle}"
                                Click="OnChoiceClicked" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LastPointerStatus" AutomationProperties.AutomationId="LastPointerStatus" Text="No pointer press yet." />
                    <TextBlock x:Name="ChoiceStatus" Text="No option activated yet." />
                </StackPanel>
            </controls:ControlExample>
        </StackPanel>
    </Grid>
</Page>