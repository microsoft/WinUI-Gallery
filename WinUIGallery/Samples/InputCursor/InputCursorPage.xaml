<Page
    x:Class="WinUIGallery.ControlPages.InputCursorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIGallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIGallery.ControlPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel>
        <controls:ControlExample x:Name="Example1" SampleDefinition="InputCursor\InputCursorSystemCursor.txt">
            <controls:ControlExample.Example>
                <local:CursorGrid
                    x:Name="CursorArea"
                    Width="300"
                    Height="200"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Loaded="CursorArea_Loaded">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Hover over this area" />
                </local:CursorGrid>
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <ComboBox
                    x:Name="CursorShapeComboBox"
                    MinWidth="200"
                    VerticalAlignment="Top"
                    Header="Cursor shape"
                    ItemsSource="{x:Bind CursorShapes}"
                    SelectedIndex="2"
                    SelectionChanged="CursorShapeComboBox_SelectionChanged" />
            </controls:ControlExample.Options>
            <controls:ControlExample.Substitutions>
                <controls:ControlExampleSubstitution Key="CursorShape" Value="{x:Bind CursorShapeComboBox.SelectedItem, Mode=OneWay}" />
            </controls:ControlExample.Substitutions>
        </controls:ControlExample>
    </StackPanel>
</Page>